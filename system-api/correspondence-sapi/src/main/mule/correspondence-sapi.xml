<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:http="http://www.mulesoft.org/schema/mule/http"
  xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
  xmlns:db="http://www.mulesoft.org/schema/mule/db"
  xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
    http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
    http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <flow name="correspondence-sapi-main">
    <http:listener config-ref="correspondence_sapi_httpListenerConfig" path="/api/*">
      <http:response statusCode="#[vars.httpStatus default 200]">
        <http:headers>#[vars.outboundHeaders default {}]</http:headers>
      </http:response>
      <http:error-response statusCode="#[vars.httpStatus default 500]">
        <http:body>#[payload]</http:body>
        <http:headers>#[vars.outboundHeaders default {}]</http:headers>
      </http:error-response>
    </http:listener>
    <apikit:router config-ref="correspondence_sapi_config" />
        <error-handler ref="global-error-handler" />
  </flow>

  <flow name="get:\correspondence-requests:correspondence_sapi_config">
		<db:select doc:name="List correspondence requests" doc:id="8e814f6a-46f9-4181-9d9d-757e8db4a69c" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT request_id, customer_id, template_code, channel, status,
       idempotency_key, document_id, created_at, updated_at
FROM correspondence_request
WHERE (CAST(:status AS text) IS NULL OR status = CAST(:status AS text))
  AND (CAST(:customerId AS text) IS NULL OR customer_id = CAST(:customerId AS text))
ORDER BY created_at DESC
LIMIT 50]]></db:sql>
			<db:input-parameters><![CDATA[#[{
    status:     attributes.queryParams.status default null,
    customerId: attributes.queryParams.customerId default null
}]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Rows to API resources" doc:id="c468f24d-df93-4c96-9bbd-2670665d78ac" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
import dw::Mappers
output application/json
---
payload map ((row) -> Mappers::toResource(row))]]></ee:set-payload>
			</ee:message>
		</ee:transform>
  </flow>

  <flow name="post:\correspondence-requests:correspondence_sapi_config">
		<ee:transform doc:name="Prepare request values" doc:id="4e9d7c88-d4f2-440e-8559-a74dbc8331fd" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="newRequest" ><![CDATA[%dw 2.0
output application/java
---
{
	requestId:      uuid(),
    customerId:     payload.customerId,
    templateCode:   payload.templateCode,
    channel:        payload.channel,
    idempotencyKey: payload.idempotencyKey
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<db:insert doc:name="Insert correspondence request" doc:id="6971d5b7-8931-4838-a74e-20165fbca1c5" config-ref="Database_Config">
			<error-mapping sourceType="DB:QUERY_EXECUTION" targetType="APP:DUPLICATE_KEY" />
			<db:sql ><![CDATA[INSERT INTO correspondence_request (request_id, customer_id, template_code, channel, idempotency_key)
VALUES (CAST(:requestId AS uuid), :customerId, :templateCode, :channel, :idempotencyKey)]]></db:sql>
			<db:input-parameters><![CDATA[#[vars.newRequest]]]></db:input-parameters>
		</db:insert>
		<db:select doc:name="Read back created request" doc:id="7df02aae-e629-4061-98d4-67d0dccb9447" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT request_id, customer_id, template_code, channel, status,
       idempotency_key, document_id, created_at, updated_at
FROM correspondence_request
WHERE request_id = CAST(:requestId AS uuid)]]></db:sql>
			<db:input-parameters ><![CDATA[#[{ requestId: vars.newRequest.requestId }]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Build 201 response" doc:id="e741994f-7be2-417d-bf0d-63ba7ffb05b9" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
import dw::Mappers
output application/json
---
Mappers::toResource(payload[0])]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<set-variable value="#[201]" doc:name="Set 201 status" doc:id="6069644b-0062-420f-b811-a9926b336742" variableName="httpStatus"/>
  </flow>

  <flow name="get:\correspondence-requests\(requestId):correspondence_sapi_config">
  <choice doc:name="Valid UUID?">
    <when expression="#[not (attributes.uriParams.requestId matches /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/)]">
        <raise-error type="APP:INVALID_ID" description="requestId must be a UUID" />
    </when>
    <otherwise>
        <logger level="DEBUG" message="requestId format ok" />
    </otherwise>
</choice>
       <db:select config-ref="Database_Config" doc:name="Select request by id">
      <db:sql><![CDATA[
        SELECT request_id, customer_id, template_code, channel, status,
               idempotency_key, document_id, created_at, updated_at
        FROM correspondence_request
        WHERE request_id = CAST(:requestId AS uuid)
      ]]></db:sql>
      <db:input-parameters><![CDATA[#[{ requestId: attributes.uriParams.requestId }]]]></db:input-parameters>
    </db:select>
    <choice doc:name="Found?">
      <when expression="#[isEmpty(payload)]">
        <raise-error type="APP:NOT_FOUND" description="No correspondence request with that id" />
      </when>
      <otherwise>
        <ee:transform doc:name="Row to API resource">
          <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
import dw::Mappers
output application/json
---
Mappers::toResource(payload[0])
]]></ee:set-payload>
          </ee:message>
        </ee:transform>
      </otherwise>
    </choice>
  </flow>

</mule>